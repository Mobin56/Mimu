# Copy this file to .env and configure either OpenAI or Gemini for text chat.
# The backend reads this file; never place secrets in frontend/.env or NEXT_PUBLIC_*.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MIMU_DATA_DIR=~/.mimu-ai
FRONTEND_ORIGIN=http://localhost:3000
# For a cloud backend, set this to your exact Netlify site URL.
# Multiple trusted origins can be comma-separated.
